{
  "autoCompactWindow": 450000,
  "outputStyle": "Concise",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "cowork-plugin-management@synced": false
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" guard_risky_review.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" guard_destructive_git.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" guard_private_email.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" guard_root_scan.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" guard_secret_files.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" guard_worker_route.py",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" progress_reminder.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" plain_report.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" context_size.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" before_compact.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" after_compact.txt; cat \"$CLAUDE_PROJECT_DIR/.myagentkit/compact-note.md\" 2>/dev/null && rm -f \"$CLAUDE_PROJECT_DIR/.myagentkit/compact-note.md\"; true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear|startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/kit_hook.sh\" handoff_pending.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$MYAGENTKIT_ROLE\" = worker ] && exit 0; f=\"$CLAUDE_PROJECT_DIR/docs/research/ai-watch.md\"; [ -f \"$f\" ] || f=/dev/null; awk -v t=\"$(date +%F)\" 'function n(s, y,m,d,e){y=substr(s,1,4)+0;m=substr(s,6,2)+0;d=substr(s,9,2)+0;y-=(m<=2);e=int(y/400);y-=e*400;return e*146097+y*365+int(y/4)-int(y/100)+int((153*(m>2?m-3:m+9)+2)/5)+d-1} s==\"\"&&/^Son tarama: [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/{s=$3} END{if(s==\"\")r=\"yok\";else{k=n(t)-n(s);if(k<=7)exit;r=k\" gün önce\"} print \"ai-watch: son tarama \" r \" (docs/research/ai-watch.md); paralelde aiwatch araştırma işçisini başlat\"}' \"$f\" 2>/dev/null; true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "deep-research": "off",
    "docs": "off",
    "docx": "off",
    "google-workspace": "off",
    "import-memory": "off",
    "morning": "off",
    "pdf": "off",
    "pptx": "off",
    "setup-writing-style": "off",
    "skill-creator": "off",
    "xlsx": "off"
  }
}
