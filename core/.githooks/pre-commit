#!/usr/bin/env sh
# KIT-OWNED: do not edit locally; change it in the kit and re-sync.
# Runs the project gate before every commit, so passing it never depends on an agent (or a
# human) remembering to. CI runs the same script — one definition of "green".
#
# That is not a promise that local and CI always agree: same script, different machine.
# A file mode, a missing tool or a locale can differ (docs/GOTCHAS.md). Check the pipeline
# after pushing rather than inferring it from a local pass.
#
# Enable once per clone:  git config core.hooksPath .githooks   (docs/DEV_SETUP.md)
# WIP escape hatch:       git commit --no-verify
#   That hatch belongs to the owner. Agents must NOT use it (AGENTS.md); in the Claude Code
#   overlay a PreToolUse hook (.claude/hooks/guard_destructive_git.py) refuses it to them.
#
# A gate wired into git is the only kind that survives: one that depends on discipline
# erodes the first time someone is in a hurry.
#
# One master writer per main checkout (docs/WORKFLOW.md, "Parallel work — worktree policy"):
# while .myagentkit/master-writer names a session (scripts/master_writer.py claim), any other
# session's commit or merge in the MAIN checkout is refused here, before the project's hook
# and the gate: the gate takes minutes, and the races it let through were the reason
# (project_leeway, 2026-10-22). A linked worktree is never refused; no marker, no refusal.
# The session is CLAUDE_CODE_SESSION_ID, which Claude Code exports to every shell it runs,
# so git and this hook inherit it; MYAGENTKIT_SESSION_ID names a session without one. No id
# at all is a human, the owner's terminal: let through with one note (owner, 2026-10-22).
# Only commits and merge commits run a hook: a fast-forward, a rebase, a cherry-pick, a pull
# or a `git add` in the main checkout moves or stages past it, and the rule's text alone holds.
# pre-merge-commit asks with --master-writer, before its own project hook.
case "${1:-}" in --merge|--master-writer) hook=pre-merge-commit ;; *) hook=pre-commit ;; esac
here=$(git rev-parse --absolute-git-dir) && common=$(git rev-parse --git-common-dir) &&
  here=$(CDPATH= cd -- "$here" && pwd -P) && common=$(CDPATH= cd -- "$common" && pwd -P) &&
  marker="$(git rev-parse --show-toplevel)/.myagentkit/master-writer" || exit 1
# Claude Code, making a worktree (sub-agent isolation, EnterWorktree), writes core.hooksPath as the
# main checkout's absolute .githooks into the shared .git/config, so every worktree runs main's hooks,
# not its own branch's (leeway 2026-10-27, seven times). Set back to .githooks, which each tree reads as
# its own; this run is already main's hook, the next one is the tree's. Any other path is left alone.
hooks_path=$(git config core.hooksPath 2>/dev/null) || hooks_path=
case $hooks_path in /*|[A-Za-z]:/*|[A-Za-z]:\\*)
  main_hooks=$(CDPATH= cd -- "$common/../.githooks" 2>/dev/null && pwd -P) || main_hooks=
  if [ -n "$main_hooks" ] && [ "$(CDPATH= cd -- "$hooks_path" 2>/dev/null && pwd -P)" = "$main_hooks" ] &&
    git config core.hooksPath .githooks; then
    printf '%s\n' "$hook: core.hooksPath was the absolute '$hooks_path' (Claude Code writes it when it makes a worktree); set back to .githooks" >&2
  fi ;;
esac
if [ "$here" = "$common" ] && [ -e "$marker" ]; then
  writer=$(sed -n '1s/[[:space:]]*$//p' "$marker" 2>/dev/null)
  name=$(sed -n '2s/[[:space:]]*$//p' "$marker" 2>/dev/null)
  me=${MYAGENTKIT_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}
  if [ -n "$writer" ] && [ -z "$me" ]; then
    printf '%s\n' "$hook: no session id, so taken for the owner's terminal and let through; the master writer is $writer." >&2
    # #311: also one line in .myagentkit/owner-terminal.log, which the lead reads (docs/WORKFLOW.md): a session
    # started without an id is seen there, not only in a terminal nobody watches. A failed write blocks nothing.
    # A merge runs this script twice (pre-merge-commit: --master-writer, then --merge): only the first logs.
    [ "${1:-}" = --merge ] || printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "$hook: no session id, let through as the owner's terminal; master writer $writer; HEAD $(git rev-parse -q --verify HEAD)" \
      >> "$(dirname -- "$marker")/owner-terminal.log" 2>/dev/null || true
  elif [ -z "$writer" ] || [ "$me" != "$writer" ]; then
    shape=$(sed -n '/^- MERGE REQUEST: /{s///;s/[.[:space:]]*$//;p;}' "$(dirname -- "$marker")/../docs/COMMUNICATION.md" 2>/dev/null)
    printf '%s\n' "$hook: refused before the gate ran: .myagentkit/master-writer names ${writer:-nothing readable}${name:+ (session name $name)} as the" \
      "  one session that commits and merges in this main checkout, and this is ${me:-a session without an id}." \
      "  Commit on your own branch in your own worktree, then send the master writer" \
      "  MERGE REQUEST: ${shape:-the shape in docs/COMMUNICATION.md, \"Workers\"} (base commit: $(git rev-parse -q --verify HEAD))" \
      "  or wait for MAIN CHECKOUT IDLE, then: python3 scripts/master_writer.py claim (python on native Windows)" >&2
    exit 1
  fi
fi
[ "${1:-}" != --master-writer ] || exit 0
# A hook of the project's own (husky, lefthook, a script of its own) lives beside this
# one as pre-commit.project, project-owned, and runs FIRST with git's arguments: its failure
# is the commit's failure, and this hook still runs after it. No other hooks path.
project_hook="$(dirname -- "$0")/pre-commit.project"
# git passes pre-commit no arguments; --merge is this kit's own (from pre-merge-commit). A
# clean merge runs pre-commit.project too, after pre-merge-commit.project, as git's own
# pre-merge-commit runs pre-commit (githooks(5); #153, owner decision 60).
# A hook without a #! line is refused: Git for Windows never runs one, chmod +x or not, and
# the documented one-line form was skipped in silence, so the project's own check never ran
# (#165). One with a #! line and no execute bit is still skipped: chmod -x switches it off.
if [ -x "$project_hook" ]; then "$project_hook" || exit $?
elif [ -f "$project_hook" ] && case $(head -n 1 -- "$project_hook") in '#!'*) false ;; esac; then
  printf '%s\n' "pre-commit: $project_hook has no #! line, and Git for Windows never runs such a file. Commit refused. Start it with #!/bin/sh and chmod +x it, or delete it." >&2; exit 1
fi
set -u

root=$(git rev-parse --show-toplevel) || exit 1
CDPATH= cd -- "$root" || exit 1

# Git runs this hook before it decides there is anything to commit: `commit -a` on a clean
# tree, a forgotten `git add` and a message-only amend each ran the whole gate, then git said
# "nothing to commit" (#232). When the index equals HEAD the commit records HEAD's tree, which
# the gate vouched for when HEAD was committed. A merge always runs it; a first commit too.
# --merge is the only sign of a clean merge: git writes no MERGE_HEAD before pre-merge-commit
# (git 2.47). Submodules are never ignored: diff.ignoreSubmodules=all hid a staged bump.
if [ "${1:-}" != --merge ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null &&
   git diff --cached --quiet --ignore-submodules=none HEAD -- 2>/dev/null; then
  echo "pre-commit: nothing staged differs from HEAD, so the gate did not run: this commit records HEAD's tree." >&2
  exit 0
fi

# Fast gate only, never an opt-in gate. Everything slow stays out of the commit path: a
# project's opt-in gates (an engine running in batchmode, an integration suite) cost minutes
# and sometimes need a live install.
# A commit hook people start bypassing is worse than no commit hook, and slowness is what
# makes them start.
#
# BEING OUT OF THE COMMIT PATH IS NOT BEING OPTIONAL, and this comment used to imply it was.
# Each of those gates has its own binding trigger written down where it is defined — an
# engine gate typically at task completion ("this work is not done until its tests pass").
# Honour the trigger the gate states.
#
# Do not assume CI covers them either: the CI this kit ships runs `./scripts/check.sh` and
# nothing else, so an opt-in gate runs in CI only if the project added it there deliberately.
# Check before believing it.
#
# --for-commit lets the gate skip the build when the staged change is documentation only;
# check.sh decides that from the index. pre-merge-commit passes --merge, and the gate gets
# --for-merge: the same documentation-only rule for the merge's result against a gated HEAD
# (project_leeway, 2026-10-22: docs-only merges each built and tested for 10-15 minutes). A
# check.sh from before an option (a project not yet upgraded) gets no flag: the full gate.
# git exports GIT_REFLOG_ACTION to a merge's hooks; a test's own repos would log every commit as
# that merge. GIT_INDEX_FILE stays: check.sh reads the staged change from it.
unset GIT_REFLOG_ACTION
if [ "${1:-}" = --merge ] && grep -q -- '--for-merge)' scripts/check.sh; then
  ./scripts/check.sh --for-merge
elif [ "${1:-}" != --merge ] && grep -q -- '--for-commit)' scripts/check.sh; then
  ./scripts/check.sh --for-commit
else
  ./scripts/check.sh
fi
status=$?
# The tree this commit records, as gated: check.sh's documentation-only path trusts only a HEAD
# whose tree it finds here. A rebase, cherry-pick or revert runs no hook (#115), and the first
# documentation-only commit after one builds. One file per worktree, overwritten.
if [ "$status" -eq 0 ]; then
  gated_tree=$(git write-tree) && printf '%s\n' "$gated_tree" > "$(git rev-parse --git-path check-gated-tree)"
  exit 0
fi
# 75: another gate run held the lock past GATE_LOCK_WAIT. Nothing was checked, so the commit
# stays blocked, but calling that a failure sends someone hunting for a defect that is not there.
if [ "$status" -eq 75 ]; then
  echo "pre-commit: check.sh did NOT RUN (another gate run holds the lock); commit blocked. Commit again when it finishes." >&2
  exit 1
fi
echo "pre-commit: check.sh FAILED — commit aborted. Fix the failure. Only the owner bypasses this gate." >&2
exit 1
