#!/usr/bin/env sh
# KIT-OWNED: do not edit locally; change it in the kit and re-sync.
# Rejects a trailer crediting an AI tool (AGENTS.md: no AI attribution in git).
# Coding tools add that trailer by default at commit time, so a rule in a document did not
# hold: sessions carried it into most commits of a project whose owner had forbidden it,
# and removing it later meant rewriting every commit and a force-push. The trailer is
# written into the message file git passes here, so this is the only place to catch it.
# A human passes, even one whose name contains a tool's ("Claude Monet", "Ana Raider"):
# a trailer is rejected only when its whole name is a tool or model name, its address is
# a tool vendor's or a [bot], or a "Generated with" line names a tool.
set -u
# The owner decides (setup interview): without the rule line in AGENTS.md, AI tools may be
# credited. A missing AGENTS.md is a broken setup, not a choice: the hook stays on, and so
# does an AGENTS.md grep cannot read: an error is not the owner's choice either.
if [ -f AGENTS.md ]; then
  grep -q 'No AI attribution in git' AGENTS.md
  case $? in
    0) ;;
    1) exit 0 ;;
    *) echo "commit-msg: cannot read AGENTS.md for the attribution rule; refusing to pass the message unchecked." >&2
       exit 1 ;;
  esac
fi
msg=${1:-}
# Git cuts the diff below the scissors line (`commit -v`) only AFTER this hook, so a trailer
# quoted in that diff is not part of the message and the text below the line is dropped.
# Only the header git writes for an editor is cut: the scissors line followed by its two-line
# explanation. A bare scissors line in a `-m` or verbatim message is kept by git, and so is
# what follows it, so the hook keeps and checks it too; cutting at any scissors line let a
# credit below one into the history. A git whose messages are translated writes another
# explanation; its quoted diff is then checked, which fails closed.
# Comment lines are NOT dropped: whether git keeps them depends on commit.cleanup, on a
# --cleanup flag this hook cannot see, and on `-m` versus the editor (git's default keeps
# them for -m). Checking them fails closed; a commented-out credit left by a squash is one
# line to delete. core.commentChar names the scissors prefix ("auto" is taken as "#").
comment=$(git config --get core.commentChar 2>/dev/null) || comment='#'
[ "$comment" != auto ] || comment='#'
if [ ! -f "$msg" ] || [ ! -r "$msg" ] || ! body=$(CC="$comment" awk '
    BEGIN { c = ENVIRON["CC"] }
    held == 1 && $0 == c " Do not modify or remove the line above." { held = 2; text = text "\n" $0; next }
    held == 2 && $0 == c " Everything below it will be ignored." { exit }
    held { print text; held = 0 }
    $0 == c " ------------------------ >8 ------------------------" { held = 1; text = $0; next }
    { print }
    END { if (held) print text }' "$msg"); then
  echo "commit-msg: cannot read the commit message file '$msg'; refusing to pass it unchecked." >&2
  exit 1
fi
# ponytail: fixed lists of tool, model and vendor names; extend them when a new tool's trailer gets through.
tools='claude|anthropic|openai|chatgpt|gpt|codex|copilot|gemini|cursor|aider|devin|windsurf|codeium|tabnine|amp|qwen|cline|kiro'
words="$tools|opus|sonnet|haiku|code|coder|agent|ai|assist|assistant|cli|chat|pro|flash|mini|turbo|[a-z]*[0-9][a-z0-9.]*"
domains='anthropic\.com|openai\.com|ampcode\.com|cursor\.(com|sh)|aider\.chat|devin\.ai|cognition\.ai|windsurf\.com|codeium\.com|tabnine\.com'
# Behind a comment character (whatever core.commentChar is) a trailer is still checked:
# git keeps "# Co-Authored-By: ..." under -m or verbatim cleanup.
trailer='^[^[:alnum:]]*[a-z]+(-[a-z]+)*-by:'
sep='[[:space:]:_/().,-]'
printf '%s\n' "$body" | grep -inE \
  -e "$trailer[[:space:]]*((github|google|openai)[[:space:]]+)?($tools)([0-9][a-z0-9.]*)?($sep+($words))*$sep*(<|\$)" \
  -e "$trailer.*(\\[bot\\]|@([a-z0-9-]+\\.)*($domains)>)" \
  -e "^[^[:alnum:]]*generated (with|by)[[:space:]]*\\[?((github|google|openai)[[:space:]]+)?($tools)([^[:alnum:]]|\$)" >&2
case $? in
  0) echo "commit-msg: crediting an AI tool (above) is not allowed in this repository (AGENTS.md)." >&2
     echo "            Remove the line and commit again; the tool's default does not override the rule." >&2
     exit 1 ;;
  1) exit 0 ;;
  *) echo "commit-msg: the trailer check itself failed; refusing to pass the message unchecked." >&2
     exit 1 ;;
esac
