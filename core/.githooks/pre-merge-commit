#!/usr/bin/env sh
# KIT-OWNED: do not edit locally; change it in the kit and re-sync.
# A clean `git merge` does not run pre-commit for the merge commit it creates; it runs this
# hook. Without it, two branches that each pass the gate can merge into a tree that fails
# it, and nothing runs the gate. A conflicted merge is finished with `git commit`, which
# runs pre-commit; a fast-forward creates no commit and runs no hook. The tree it brings in
# was gated only if no rebase, cherry-pick or revert made it: those run no hook either (#115),
# so `./scripts/check.sh` runs on a rebased branch before it fast-forwards (docs/WORKFLOW.md).
# --merge: a merge commit always gets the full gate, the build included, even when what the
# merge brings in is documentation only (git shows no MERGE_HEAD to this hook).
# A hook of the project's own (husky, lefthook, a script of its own) lives beside this
# one as pre-merge-commit.project, project-owned, and runs FIRST with git's arguments: its failure
# is the commit's failure, and this hook still runs after it. No other hooks path.
# The master-writer refusal (pre-commit says how) comes before it.
sh "$(dirname -- "$0")/pre-commit" --master-writer || exit 1
project_hook="$(dirname -- "$0")/pre-merge-commit.project"
# A hook without a #! line is refused: Git for Windows never runs one, chmod +x or not, and
# the documented one-line form was skipped in silence, so the project's own check never ran
# (#165). One with a #! line and no execute bit is still skipped: chmod -x switches it off.
if [ -x "$project_hook" ]; then "$project_hook" "$@" || exit $?
elif [ -f "$project_hook" ] && case $(head -n 1 -- "$project_hook") in '#!'*) false ;; esac; then
  printf '%s\n' "pre-merge-commit: $project_hook has no #! line, and Git for Windows never runs such a file. Merge refused. Start it with #!/bin/sh and chmod +x it, or delete it." >&2; exit 1
fi
exec sh "$(dirname -- "$0")/pre-commit" --merge
