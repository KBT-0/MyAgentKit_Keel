#!/usr/bin/env sh
# KIT-OWNED: do not edit locally; change it in the kit and re-sync.
# A clean `git merge` does not run pre-commit for the merge commit it creates; it runs this
# hook. Without it, two branches that each pass the gate can merge into a tree that fails
# it, and nothing runs the gate. A conflicted merge is finished with `git commit`, which
# runs pre-commit; a fast-forward creates no commit and brings in a tree already gated.
# --merge: a merge commit always gets the full gate, the build included, even when what the
# merge brings in is documentation only (git shows no MERGE_HEAD to this hook).
# A hook of the project's own (husky, lefthook, a script of its own) lives beside this
# one as pre-merge-commit.project, project-owned, and runs FIRST with git's arguments: its failure
# is the commit's failure, and this hook still runs after it. No other hooks path.
project_hook="$(dirname -- "$0")/pre-merge-commit.project"
if [ -x "$project_hook" ]; then "$project_hook" "$@" || exit $?; fi
exec sh "$(dirname -- "$0")/pre-commit" --merge
