# MyAgentKit_Keel's OWN ignore file. This is not the .gitignore the kit installs into a
# project — that one lives in core/.gitignore and is assembled from fragments.

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.py[cod]
*.swp
.idea/
.vs/

# Output of a local bootstrap.sh smoke test (see docs/ACCEPTANCE.md).
/.smoke-test/

# Agent tooling working copies, never repository content.
.claude/worktrees/

# Private invocation diagnostics and subscription usage never belong in a public push.
/.myagentkit/
# Raw review evidence holds the whole diff and the reviewing CLI's own output. It stays
# local; publish a deliberately scrubbed `-summary.md` instead (re-included at the bottom).
/docs/reviews/????????T??????Z-*.md
/docs/handoffs/*-claude-propose.json
# Legacy name from before every reviewer shared one Markdown format.
/docs/reviews/*-claude-review.json
!/docs/reviews/*-summary.md
